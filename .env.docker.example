# ============================================================
# SmartCoop — Docker Production Environment
# Salin file ini ke .env.docker dan isi dengan nilai asli
# JANGAN commit .env.docker ke Git!
# ============================================================

# ── MySQL ────────────────────────────────────────────────────
MYSQL_ROOT_PASSWORD=rezatugasakhir09
MYSQL_DATABASE=db_chicken_choop
MYSQL_USER=smartcoop_user
MYSQL_PASSWORD=rezatugasakhir09

# ── Laravel App ──────────────────────────────────────────────
APP_NAME=SmartCoop
APP_ENV=production
APP_DEBUG=false
APP_URL=http://YOUR_SERVER_IP_OR_DOMAIN

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=db_chicken_choop
DB_USERNAME=smartcoop_user
DB_PASSWORD=rezatugasakhir09

# ── MQTT Broker ───────────────────────────────────────────────
MQTT_HOST=mosquitto
MQTT_PORT=1883
MQTT_USERNAME=laravel_worker
MQTT_PASSWORD=rezatugasakhir09

# ── Session & Cache ───────────────────────────────────────────
SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=database
