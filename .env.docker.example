# ============================================================
# SmartCoop — Docker Production Environment
# Salin file ini ke .env.docker dan isi dengan nilai asli
# JANGAN commit .env.docker ke Git!
# ============================================================

# ── MySQL ────────────────────────────────────────────────────
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_DATABASE=db_chicken_choop
MYSQL_USER=user
MYSQL_PASSWORD=userpassword

# ── Laravel App ──────────────────────────────────────────────
APP_NAME=SmartCoop
APP_ENV=production
APP_DEBUG=false
APP_URL=http://localhost

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=db_chicken_choop
DB_USERNAME=root
DB_PASSWORD=rootpassword

# ── MQTT Broker ───────────────────────────────────────────────
MQTT_HOST=mosquitto
MQTT_PORT=1883
MQTT_USERNAME=laravel_worker
MQTT_PASSWORD=rezatugasakhir09

# ── Session & Cache ───────────────────────────────────────────
SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=database

# ── Grafana Monitoring ────────────────────────────────────────
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin123
